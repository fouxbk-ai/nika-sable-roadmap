---
import { STATUS_COLORS, STATUS_LABELS, type TaskBlock } from '../lib/types';

type Props = {
  task: TaskBlock;
};

const { task } = Astro.props;
const percent = Math.round(task.progress * 100);
const obsidianUrl = `obsidian://open?vault=Obsidian%20Vault&file=${encodeURIComponent(task.vaultPath)}`;
---

<article class="surface rounded-xl p-5">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <div class="mono text-xs font-semibold uppercase tracking-wide text-emerald-400">Блок {task.block}</div>
      <h2 class="mt-2 text-base font-bold leading-snug text-gray-100">{task.title}</h2>
    </div>
    <span class="status-chip" style={`color: ${STATUS_COLORS[task.status]}`}>{STATUS_LABELS[task.status]}</span>
  </div>

  <div class="mt-5">
    <div class="mb-2 flex items-center justify-between text-xs text-gray-400">
      <span>{task.doneCheckboxes} / {task.totalCheckboxes} чек-боксов</span>
      <span class="mono">{percent}%</span>
    </div>
    <div class="h-2 overflow-hidden rounded-full bg-white/5">
      <div class="h-full rounded-full" style={`width: ${percent}%; background: ${STATUS_COLORS[task.status]}`}></div>
    </div>
  </div>

  <dl class="mt-5 grid grid-cols-2 gap-3 text-xs text-gray-400">
    <div>
      <dt class="mb-1 text-gray-500">Создано</dt>
      <dd class="mono text-gray-300">{task.created}</dd>
    </div>
    <div>
      <dt class="mb-1 text-gray-500">Срок</dt>
      <dd class="mono text-gray-300">{task.start} → {task.due}</dd>
    </div>
  </dl>

  <div class="mt-5 flex flex-wrap items-center gap-2">
    <a class="status-chip text-emerald-300 transition hover:border-emerald-400/50 hover:text-emerald-200" href={obsidianUrl} target="_blank" rel="noreferrer">
      Открыть в Obsidian
    </a>
    {task.dependsOn.map((dependency) => <span class="status-chip text-gray-400">после блока {dependency}</span>)}
    {task.dependsOn.length === 0 && <span class="status-chip text-gray-500">без зависимостей</span>}
  </div>
</article>
